  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "llm",
    "codex",
    "claude",
    "grok",
    "cursor",
    "ollama"
  ],
  "mcpServers": {
    "omni-llm": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ]
    }
  }
